{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react"
  ],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/out/**",
    "**/dist/**",
    "**/release/**",
    "**/node_modules/**",
    "**/coverage/**",
    "**/test-results/**",
    "**/.cache/**",
    ".claude/**",
    ".qa/**",
    "packages/chrome-extensions/src/**",
    "packages/chrome-extensions/types/**"
  ],
  "rules": {
    "constructor-super": "error",
    "for-direction": "error",
    "getter-return": "error",
    "no-async-promise-executor": "error",
    "no-case-declarations": "error",
    "no-class-assign": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": "error",
    "no-const-assign": "error",
    "no-constant-binary-expression": "error",
    "no-constant-condition": "error",
    "no-control-regex": "error",
    "no-debugger": "error",
    "no-delete-var": "error",
    "no-dupe-class-members": "error",
    "no-dupe-else-if": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty": "error",
    "no-empty-character-class": "error",
    "no-empty-pattern": "error",
    "no-empty-static-block": "error",
    "no-ex-assign": "error",
    "no-extra-boolean-cast": "error",
    "no-fallthrough": "error",
    "no-func-assign": "error",
    "no-global-assign": "error",
    "no-import-assign": "error",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "error",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-new-native-nonconstructor": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-obj-calls": "error",
    "no-prototype-builtins": "error",
    "no-redeclare": "error",
    "no-regex-spaces": "error",
    "no-self-assign": "error",
    "no-setter-return": "error",
    "no-shadow-restricted-names": "error",
    "no-sparse-arrays": "error",
    "no-this-before-super": "error",
    "no-unassigned-vars": "error",
    "no-unexpected-multiline": "error",
    "no-unreachable": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-negation": "error",
    "no-unsafe-optional-chaining": "error",
    "no-unused-labels": "error",
    "no-unused-private-class-members": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-useless-backreference": "error",
    "no-useless-catch": "error",
    "no-useless-escape": "error",
    "no-with": "error",
    "preserve-caught-error": "error",
    "require-yield": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "no-array-constructor": "error",
    "no-unused-expressions": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "electron",
            "importNames": [
              "remote"
            ],
            "message": "The remote module is not used in Chord."
          }
        ]
      }
    ],
    "typescript/ban-ts-comment": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error",
    "typescript/consistent-type-imports": "error",
    "react/error-boundaries": "warn",
    "react/exhaustive-deps": "warn",
    "react/forward-ref-uses-ref": "warn",
    "react/globals": "warn",
    "react/immutability": "warn",
    "react/incompatible-library": "warn",
    "react/jsx-key": "error",
    "react/jsx-no-duplicate-props": "warn",
    "react/jsx-no-undef": "error",
    "react/jsx-props-no-spread-multi": "warn",
    "react/no-children-prop": "warn",
    "react/no-danger-with-children": "warn",
    "react/no-did-mount-set-state": "warn",
    "react/no-did-update-set-state": "warn",
    "react/no-direct-mutation-state": "error",
    "react/no-find-dom-node": "warn",
    "react/no-is-mounted": "warn",
    "react/no-render-return-value": "warn",
    "react/no-string-refs": "warn",
    "react/no-this-in-sfc": "warn",
    "react/no-unsafe": "warn",
    "react/no-will-update-set-state": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/purity": "warn",
    "react/refs": "warn",
    "react/rules-of-hooks": "error",
    "react/set-state-in-effect": "warn",
    "react/set-state-in-render": "warn",
    "react/static-components": "warn",
    "react/use-memo": "warn",
    "react/void-dom-elements-no-children": "error",
    "react/void-use-memo": "warn",
    "no-useless-assignment": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.mts",
        "**/*.cts"
      ],
      "rules": {
        "constructor-super": "off",
        "getter-return": "off",
        "no-class-assign": "off",
        "no-const-assign": "off",
        "no-dupe-class-members": "off",
        "no-dupe-keys": "off",
        "no-func-assign": "off",
        "no-import-assign": "off",
        "no-new-native-nonconstructor": "off",
        "no-obj-calls": "off",
        "no-redeclare": "off",
        "no-setter-return": "off",
        "no-this-before-super": "off",
        "no-unreachable": "off",
        "no-unsafe-negation": "off",
        "no-var": "error",
        "no-with": "off",
        "prefer-const": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error"
      }
    },
    {
      "files": [
        "packages/core/**/*.ts",
        "packages/tokens/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              "electron"
            ],
            "patterns": [
              "electron/*"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/desktop/src/renderer/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The renderer is a web page: it talks to main through packages/ipc, never Electron."
              }
            ],
            "patterns": [
              {
                "group": [
                  "electron/*"
                ],
                "message": "The renderer is a web page: it talks to main through packages/ipc, never Electron."
              },
              {
                "group": [
                  "node:*"
                ],
                "message": "The renderer is a web page: no Node modules."
              },
              {
                "regex": "^(\\.\\./)+(main|preload)(/|$)",
                "message": "The renderer never imports main's or preload's code: shared code goes in packages/core, channels in packages/ipc."
              }
            ]
          }
        ]
      }
    },
    // The React Compiler rules that already fire, turned off only in the files where they do (77 warnings on
    // 2026-11-24, before `--deny-warnings`). The compiler skips a component that breaks one, so it runs as plain React
    // (correct, just not memoized automatically). New files get every rule. Take a file out of a list once it is clean.
    // react/exhaustive-deps: effects meant to run once or on one key (focus on open, reset when a thread or prompt changes).
    {
      "files": [
        "apps/desktop/src/renderer/overlay/CommandBar.tsx",
        "apps/desktop/src/renderer/popover/Popover.tsx",
        "apps/desktop/src/renderer/reader/Reader.tsx",
        "apps/desktop/src/renderer/settings/Appearance.tsx",
        "apps/desktop/src/renderer/settings/PasswordTransfer.tsx",
        "apps/desktop/src/renderer/shared/a11y.ts",
        "apps/desktop/src/renderer/shell/App.tsx",
        "apps/desktop/src/renderer/shell/Assistant.tsx",
        "apps/desktop/src/renderer/shell/Tabs.tsx",
        "apps/desktop/src/renderer/shell/Toasts.tsx"
      ],
      "rules": {
        "react/exhaustive-deps": "off"
      }
    },
    // react/immutability: a scroll position or a presence object set imperatively, and setters a callback reads before they are declared.
    {
      "files": [
        "apps/desktop/src/renderer/overlay/CommandBar.tsx",
        "apps/desktop/src/renderer/shell/Tabs.tsx",
        "apps/desktop/src/renderer/shell/useListWindow.ts"
      ],
      "rules": {
        "react/immutability": "off"
      }
    },
    // react/purity: Date.now() for a relative time ("5 min ago") or a timestamp taken at first render.
    {
      "files": [
        "apps/desktop/src/renderer/archive/Archive.tsx",
        "apps/desktop/src/renderer/overlay/CommandBar.tsx",
        "apps/desktop/src/renderer/overlay/DownloadsPanel.tsx",
        "apps/desktop/src/renderer/shared/AgentCard.tsx",
        "apps/desktop/src/renderer/shell/Assistant.tsx"
      ],
      "rules": {
        "react/purity": "off"
      }
    },
    // react/refs: latest-value refs written during render, and ref={x.ref} from the roving-focus and menu hooks.
    {
      "files": [
        "apps/desktop/src/renderer/overlay/Peek.tsx",
        "apps/desktop/src/renderer/popover/EffectsCard.tsx",
        "apps/desktop/src/renderer/popover/Popover.tsx",
        "apps/desktop/src/renderer/reader/Reader.tsx",
        "apps/desktop/src/renderer/settings/Shortcuts.tsx",
        "apps/desktop/src/renderer/settings/controls.tsx",
        "apps/desktop/src/renderer/shared/ImportPanel.tsx",
        "apps/desktop/src/renderer/shell/App.tsx",
        "apps/desktop/src/renderer/shell/Assistant.tsx",
        "apps/desktop/src/renderer/shell/Onboarding.tsx",
        "apps/desktop/src/renderer/shell/Tabs.tsx",
        "apps/desktop/src/renderer/shell/useChordSwipe.ts",
        "apps/desktop/src/renderer/shell/useListWindow.ts"
      ],
      "rules": {
        "react/refs": "off"
      }
    },
    // react/set-state-in-effect: state reset when a prop or key changes (an edited login, a new prompt, a closed panel).
    {
      "files": [
        "apps/desktop/src/renderer/overlay/CommandBar.tsx",
        "apps/desktop/src/renderer/popover/Popover.tsx",
        "apps/desktop/src/renderer/settings/Appearance.tsx",
        "apps/desktop/src/renderer/settings/PasswordTransfer.tsx",
        "apps/desktop/src/renderer/settings/Passwords.tsx",
        "apps/desktop/src/renderer/settings/Proxy.tsx",
        "apps/desktop/src/renderer/shared/ImportPanel.tsx",
        "apps/desktop/src/renderer/shell/App.tsx",
        "apps/desktop/src/renderer/shell/Assistant.tsx",
        "apps/desktop/src/renderer/shell/Onboarding.tsx",
        "apps/desktop/src/renderer/shell/Tabs.tsx"
      ],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    },
    // react/static-components: the command bar picks its scope icon component during render.
    {
      "files": [
        "apps/desktop/src/renderer/overlay/CommandBar.tsx"
      ],
      "rules": {
        "react/static-components": "off"
      }
    }
  ]
}
