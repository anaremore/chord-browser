{
  "name": "chord-browser",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @chord/desktop dev",
    "build": "pnpm --filter @chord/desktop build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity=warn && stylelint \"**/*.css\" --ignore-pattern \".claude/**\"",
    "deadcode": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:sim": "node scripts/sync-sim.mjs",
    "test:e2e:linux": "node scripts/e2e-linux/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "knip": "6.45.1",
    "oxlint": "1.94.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
