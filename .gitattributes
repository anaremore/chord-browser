# Normalize line endings: LF in the repo and in working copies on every OS.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.icns binary
*.woff2 binary
*.ttf binary
*.db binary

# EasyList and EasyPrivacy as bundled (pnpm --filter @chord/desktop lists): collapsed in diffs.
apps/desktop/build/ad-blocking/*.txt linguist-generated=true
