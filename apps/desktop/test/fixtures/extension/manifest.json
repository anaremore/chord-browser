{
  "manifest_version": 3,
  "name": "Chord Test Extension",
  "version": "1.0",
  "description": "A small extension for Chord's end-to-end tests: an action popup with a badge, a content script, a static rule and a context-menu item.",
  "key": "",
  "permissions": ["storage", "contextMenus", "declarativeNetRequest"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Chord Test", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_start" }],
  "declarative_net_request": {
    "rule_resources": [{ "id": "blocklist", "enabled": true, "path": "rules.json" }]
  }
}
