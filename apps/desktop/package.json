{
  "name": "@chord/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Chord: a calm, colorful browser",
  "homepage": "https://github.com/anaremore/chord-browser",
  "author": {
    "name": "Chord contributors"
  },
  "license": "MIT AND MPL-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "desktopName": "com.chordbrowser.Chord.desktop",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "node scripts/electron-vite.mjs build",
    "preview": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc -b tsconfig.json",
    "icons": "node scripts/build-icons.mjs",
    "test:e2e": "playwright test",
    "test:perf": "playwright test perf",
    "test:packaged": "playwright test --config playwright.packaged.config.ts",
    "package": "node scripts/electron-vite.mjs build && electron-builder --config electron-builder.config.ts --publish never",
    "package:dir": "node scripts/electron-vite.mjs build && electron-builder --config electron-builder.config.ts --publish never --dir"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@chord/chrome-extensions": "workspace:*",
    "@chord/core": "workspace:*",
    "@chord/data": "workspace:*",
    "@chord/ipc": "workspace:*",
    "@chord/tokens": "workspace:*",
    "@dnd-kit/abstract": "0.5.1",
    "@dnd-kit/dom": "0.5.1",
    "@dnd-kit/react": "0.5.1",
    "electron-updater": "6.8.11",
    "immer": "11.2.9",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "productName": "Chord"
}
